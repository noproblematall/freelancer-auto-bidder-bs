{
  "name": "growlance",
  "version": "1.3.2",
  "private": true,
  "description": "Growlance — Freelance automation tool",
  "main": "electron/main.js",
  "scripts": {
    "electron:dev": "concurrently -n frontend,electron -c green,yellow \"npm run dev:frontend\" \"wait-on http://localhost:8080 && electron .\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "predist": "npm run prisma:generate",
    "predist:mac": "npm run prisma:generate",
    "predist:win": "npm run prisma:generate",
    "predist:linux": "npm run prisma:generate",
    "dist": "npm run build:frontend && electron-builder --publish never",
    "dist:mac": "npm run build:frontend && electron-builder --mac --publish never",
    "dist:win": "npm run build:frontend && electron-builder --win --publish never",
    "dist:linux": "npm run build:frontend && electron-builder --linux --publish never",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma && electron-rebuild -f -w better-sqlite3",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:studio": "cd backend && npx prisma studio",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-pino-logger": "^7.0.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-machine-id": "^1.1.12",
    "openai": "^4.0.0",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.0",
    "@electron/rebuild": "^4.0.3",
    "concurrently": "^9.1.2",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "prisma": "^6.4.1",
    "wait-on": "^7.2.0"
  }
}
