{
  "name": "growlance-backend",
  "version": "1.0.0",
  "description": "Growlance backend API for Freelancer.com automatic bidding",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-pino-logger": "^7.0.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@vitest/ui": "^2.1.9",
    "msw": "^2.12.10",
    "prisma": "^6.4.1",
    "supertest": "^7.2.2",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
