generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/growlance-prisma"
  binaryTargets = ["native", "darwin-arm64", "darwin", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  openaiApiKey  String?  @map("openai_api_key")
  openaiModel   String   @default("gpt-5.4-mini") @map("openai_model")

  // Bidding Settings
  bidDelaySeconds Float   @default(30)    @map("bid_delay_seconds")
  // The freelancer's hourly rate in USD, shared by every bid profile: the rate
  // bid on hourly projects and the basis for fixed-price delivery estimates.
  hourlyRate          Float?   @map("hourly_rate")
  // Delivery period bounds for AI-estimated periods, shared by every profile:
  // the estimate is kept between min and max days, and the fallback is
  // promised when nothing can be estimated.
  periodMinDays       Int?     @map("period_min_days")
  periodMaxDays       Int?     @map("period_max_days")
  periodFallbackDays  Int      @default(7) @map("period_fallback_days")
  aiBidPercentage     Int      @default(100) @map("ai_bid_percentage")          // % of the AI-suggested amount to bid
  sealBids        Boolean @default(false) @map("seal_bids")
  // Account-wide bid caps (Settings → Auto-Bidding); shared by every profile
  maxBidsPerHour  Int     @default(8)     @map("max_bids_per_hour")
  maxBidsPerDay   Int     @default(80)    @map("max_bids_per_day")
  // How many bid history records to keep; older ones are removed once a day
  // (services/bidding/historyRetention.js)
  bidHistoryLimit Int     @default(50000) @map("bid_history_limit")

  // Global Schedule Settings
  scheduleEnabled   Boolean  @default(false) @map("schedule_enabled")
  scheduleTimezone  String   @default("America/New_York") @map("schedule_timezone")
  scheduleStartTime String?  @map("schedule_start_time")
  scheduleEndTime   String?  @map("schedule_end_time")
  scheduleDays      String   @default("1,2,3,4,5") @map("schedule_days")
  // Per-day windows (JSON, see services/bidding/scheduleWeek.js). Supersedes the
  // three single-window fields above, which are kept for older rows.
  scheduleWeek      String?  @map("schedule_week")

  // Freelancer API Credentials (per-user, for TOS compliance)
  freelancerClientId     String?  @map("freelancer_client_id")
  freelancerClientSecret String?  @map("freelancer_client_secret")

  // Telegram Notification Settings
  telegramEnabled                  Boolean   @default(false) @map("telegram_enabled")
  telegramBidNotificationsEnabled  Boolean   @default(false) @map("telegram_bid_notifications_enabled")
  telegramBotToken                 String?   @map("telegram_bot_token")
  telegramChatId                   String?   @map("telegram_chat_id")
  lastMessageCheckAt               DateTime? @map("last_message_check_at")

  // Webhook Notification Settings (fires a POST on new incoming messages)
  webhookEnabled Boolean @default(false) @map("webhook_enabled")
  webhookUrl     String? @map("webhook_url")

  // Job filters (JSON) — client countries/regions/currencies and search
  // languages applied to every bidding profile's project search.
  // See services/bidding/jobFilters.js for the shape.
  jobFilters     String? @map("job_filters")

  // Account-wide bidding behaviour and AI context (apply to every profile)
  reviewMode          Boolean @default(false) @map("review_mode")
  skillsSummary       String? @map("skills_summary")
  experienceSummary   String? @map("experience_summary")
  portfolioHighlights String? @map("portfolio_highlights")
  // Account-wide proposal prompt; NULL means the shipped default (ChatGPT-prompt.md)
  proposalPrompt      String? @map("proposal_prompt")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  freelancerToken  FreelancerToken?
  biddingProfiles  BiddingProfile[]
  bids             Bid[]
  activityLogs     ActivityLog[]
  meetings         Meeting[]
  clients          Client[]
  messageThreads   MessageThread[]

  @@map("users")
}

model FreelancerToken {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique @map("user_id")
  accessToken   String   @map("access_token")
  refreshToken  String?  @map("refresh_token")
  tokenType     String?  @map("token_type")
  expiresAt     DateTime @map("expires_at")
  scopes        String?
  freelancerUid String?  @map("freelancer_uid")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("freelancer_tokens")
}

model BiddingProfile {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  name                String
  isActive            Boolean  @default(false) @map("is_active")
  // Search criteria
  searchKeywords      String?  @map("search_keywords")
  jobIds              String?  @map("job_ids")
  // Budget filters by project type
  budgetMinFixed      Float?   @map("budget_min_fixed")
  budgetMaxFixed      Float?   @map("budget_max_fixed")
  budgetMinHourly     Float?   @map("budget_min_hourly")
  budgetMaxHourly     Float?   @map("budget_max_hourly")
  countries           String?
  excludedCountries   String?  @map("excluded_countries")
  excludedRegions     String?  @map("excluded_regions")
  countryExceptions   String?  @map("country_exceptions")
  excludedCurrencies  String?  @map("excluded_currencies")
  languages           String?
  // Bidding parameters: every profile bids on both fixed-price and hourly
  // projects; each kind is priced and scheduled with its own settings. The
  // freelancer's hourly rate and the delivery period bounds are account-wide
  // (User.hourlyRate, User.periodMinDays/periodMaxDays/periodFallbackDays).
  //
  // Fixed-price projects
  fixedBidStrategy    String   @default("ai") @map("fixed_bid_strategy")         // ai | percentage
  bidPercentage       Float?   @map("bid_percentage")                            // % of max budget, strategy "percentage"
  fixedPeriodStrategy String   @default("ai") @map("fixed_period_strategy")      // ai | fixed (fixed = User.periodFallbackDays)
  // Hourly projects
  hourlyRateStrategy  String   @default("my_rate") @map("hourly_rate_strategy")  // my_rate | ai
  hourlyPeriodStrategy String  @default("ai") @map("hourly_period_strategy")     // ai | fixed (fixed = User.periodFallbackDays)
  // AI settings
  minRelevanceScore   Int      @default(70) @map("min_relevance_score")
  proposalPrompt      String?  @map("proposal_prompt")
  // Review-and-send: queue drafted bids as pending_review instead of auto-placing
  reviewMode          Boolean  @default(false) @map("review_mode")
  // Rate limiting
  maxBidsPerHour      Int      @default(5) @map("max_bids_per_hour")
  maxBidsPerDay       Int      @default(20) @map("max_bids_per_day")
  // User profile context for AI
  skillsSummary       String?  @map("skills_summary")
  experienceSummary   String?  @map("experience_summary")
  portfolioHighlights String?  @map("portfolio_highlights")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bids Bid[]

  @@map("bidding_profiles")
}

model Project {
  id                  Int       @id @default(autoincrement())
  freelancerProjectId Int       @unique @map("freelancer_project_id")
  title               String
  description         String?
  budgetMin           Float?    @map("budget_min")
  budgetMax           Float?    @map("budget_max")
  currency            String    @default("USD")
  jobIds              String?   @map("job_ids")
  ownerId             Int?      @map("owner_id")
  ownerCountry        String?   @map("owner_country")
  ownerLocation       String?   @map("owner_location")
  bidCount            Int       @default(0) @map("bid_count")
  timeSubmitted       DateTime? @map("time_submitted")
  status              String    @default("active")
  projectType         String?   @map("project_type")
  relevanceScore      Int?      @map("relevance_score")
  aiAnalysis          String?   @map("ai_analysis")
  lastCheckedAt       DateTime? @map("last_checked_at")
  discoveredAt        DateTime  @default(now()) @map("discovered_at")

  bids     Bid[]
  meetings Meeting[]

  @@map("projects")
}

model Bid {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  profileId           Int?      @map("profile_id")
  projectId           Int       @map("project_id")
  freelancerBidId     Int?      @map("freelancer_bid_id")
  amount              Float
  periodDays          Int       @map("period_days")
  milestonePercentage Int       @default(100) @map("milestone_percentage")
  proposalText        String    @map("proposal_text")
  status              String    @default("pending")
  sealed              Boolean   @default(false)
  errorMessage        String?   @map("error_message")
  placedAt            DateTime? @map("placed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile BiddingProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("bids")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Client {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  freelancerUserId  Int       @map("freelancer_user_id")
  displayName       String?   @map("display_name")
  username          String?
  country           String?
  notes             String?
  totalValue        Float     @default(0) @map("total_value")
  projectCount      Int       @default(0) @map("project_count")
  lastProjectAt     DateTime? @map("last_project_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, freelancerUserId])
  @@map("clients")
}

model MessageThread {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @map("user_id")
  freelancerThreadId      Int       @map("freelancer_thread_id")
  projectId               Int?      @map("project_id")
  clientFreelancerId      Int?      @map("client_freelancer_id")
  lastMessageFromClientAt DateTime? @map("last_message_from_client_at")
  lastMessageFromMeAt     DateTime? @map("last_message_from_me_at")
  lastMessageText         String?   @map("last_message_text")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, freelancerThreadId])
  @@map("message_threads")
}

model Meeting {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  projectId    Int?      @map("project_id")
  title        String
  startTime    DateTime  @map("start_time")
  endTime      DateTime? @map("end_time")
  notes        String?
  reminderSent Boolean   @default(false) @map("reminder_sent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("meetings")
}
