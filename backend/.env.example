# Backend
PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-to-a-random-secret
ENCRYPTION_KEY=change-me-to-64-hex-chars-for-aes256-example0123456789abcdef

# Freelancer.com
# Note: Client ID/Secret are now stored per-user (encrypted) via the Settings UI.
FREELANCER_REDIRECT_URI=http://localhost:3001/api/auth/freelancer/callback
FREELANCER_OAUTH_BASE=https://accounts.freelancer-sandbox.com
FREELANCER_API_BASE=https://www.freelancer-sandbox.com/api

# OpenAI (fallback — users can also set via Settings UI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Cheaper model used only for high-volume project scoring (proposals use OPENAI_MODEL).
OPENAI_ANALYSIS_MODEL=gpt-5.4-nano
