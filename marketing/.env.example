# Serverless checkout config — set these in your HOST's environment variables
# (Vercel/Netlify dashboard), NOT in a committed file. Copy to `.env` for local
# testing only. Never commit real secrets.

# Your Plisio API secret key (rotate the one that was shown in a screenshot!).
PLISIO_SECRET_KEY=your-plisio-secret-key

# The price charged at checkout. Keep in sync with PRICING.price in src/config.js
# (that one is only the displayed price; this one is what actually gets charged).
GROWLANCE_PRICE_USD=89
GROWLANCE_PRICE_CURRENCY=USD

# ── License server (see LICENSING.md) ────────────────────────────────────────
# Postgres connection string (e.g. a free Neon database). Run
# api/license/schema.sql against it once.
DATABASE_URL=postgres://user:pass@host/db

# Ed25519 private signing key + key-encryption secret, both base64
# (from: node scripts/gen-license-keypair.mjs). The matching PUBLIC key is
# embedded in the desktop app. Keep these secret.
LICENSE_SIGNING_PRIVATE_KEY=base64-encoded-ed25519-private-pem
LICENSE_KEY_ENC_SECRET=base64-encoded-32-byte-secret

# Download link shown on the success page after payment. Point it at the download
# proxy so it works even though the repo is private (auto-detects the buyer's OS).
DOWNLOAD_URL=https://growlance.app/api/download

# ── Download proxy (api/download.js) ─────────────────────────────────────────
# Lets the public site serve installers from PRIVATE GitHub Releases. Create a
# fine-grained Personal Access Token with READ-ONLY "Contents" access to this
# repo (github.com → Settings → Developer settings → Fine-grained tokens).
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=jzappi/Freelancer-auto-bidder

# Public site origin (used to build Plisio success/callback URLs). Optional.
BASE_URL=https://growlance.app

# Password for the web admin at /admin.html (license management). Use a long
# random string. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=your-long-random-admin-password
